[ext_resource type="Texture2D" uid="uid://w02l068uqdgc" path="res://sprites/testprojectile.png" id="1_xnpt0"]

[sub_resource type="GDScript" id="GDScript_mnies"]
script/source = "extends Area2D

@export var speed: float = 1000.0
@export var direction: Vector2 = Vector2.RIGHT

func initialize(start_position: Vector2, start_rotation: float):
	position = start_position
	rotation = start_rotation
	direction = Vector2.RIGHT.rotated(start_rotation)

func _physics_process(delta):
	# Move the projectile in its direction
	position += direction * speed * delta

func _on_body_entered(body):
	# Handle collision
	if body.is_in_group(\"enemies\"):
		body.take_damage()
		queue_free()  # Destroy the projectile
"

